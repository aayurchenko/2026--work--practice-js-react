{
  "$schema": "https://raw.githubusercontent.com/Zhengqbbb/cz-git/refs/tags/v1.14.0/docs/public/schema/cz-git.json",
  "scopes": [
    "main",
    "pure-js",
    "react",
    "docs",
    "deps",
    "tooling",
    "release"
  ],
  "allowCustomScopes": true,
  "allowEmptyScopes": true,
  "maxSubjectLength": 100
}
